<?xml version="1.0" encoding="utf-8"?>
<!-- Cast shadow at the left edge of the CategoryListFragment: drawn over the
     mgmt page (the lower layer) right next to the category list edge, to make
     the category list look like the sheet on top. Transparent on the far side,
     darkest adjacent to the category list edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="0"
        android:startColor="#00000000"
        android:endColor="#40000000" />
</shape>
