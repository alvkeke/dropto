<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mgmt_page_container"
    android:background="@color/color_background"
    android:clipToOutline="false"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/mgmt_page_item_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <cn.alvkeke.dropto.ui.component.MgmtItemView
            android:id="@+id/mgmt_page_item_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <cn.alvkeke.dropto.ui.component.MgmtItemView
            android:id="@+id/mgmt_page_item_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <cn.alvkeke.dropto.ui.component.MgmtItemView
            android:id="@+id/mgmt_page_item_reactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <cn.alvkeke.dropto.ui.component.CapsuleLayout
            android:id="@+id/mgmt_page_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/capsule_spacing"
            android:elevation="8dp"
            android:padding="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/mgmt_page_user_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:contentDescription="@string/content_description_user_avatar"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DropTo.Circle" />

            <TextView
                android:id="@+id/mgmt_page_user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_text_main"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/mgmt_page_user_logout"
                app:layout_constraintStart_toEndOf="@id/mgmt_page_user_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/mgmt_page_user_id"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/mgmt_page_user_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_text_sub"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/mgmt_page_user_logout"
                app:layout_constraintStart_toEndOf="@id/mgmt_page_user_avatar"
                app:layout_constraintTop_toBottomOf="@id/mgmt_page_user_name"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/mgmt_page_user_logout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_user_logout"
                android:scaleType="centerInside"
                android:src="@drawable/icon_common_logout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </cn.alvkeke.dropto.ui.component.CapsuleLayout>

    </LinearLayout>

    <cn.alvkeke.dropto.ui.component.CapsuleToolbar
        android:id="@+id/mgmt_page_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>
