<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="cn.alvkeke.dropto.ui.component.CapsuleLayout">

    <EditText
        android:id="@+id/password_box_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/password_box_toggle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:textColor="@color/color_text_main"
        android:textColorHint="@color/color_text_sub"
        android:inputType="textPassword"
        android:maxLines="1"
        android:importantForAutofill="no"
        android:layout_width="0dp"
        android:layout_height="@dimen/capsule_size" />

    <ImageButton
        android:id="@+id/password_box_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/icon_password_eye_displaying"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/capsule_size"
        android:layout_height="@dimen/capsule_size"
        android:contentDescription="@string/description_password_show" />

</merge>
