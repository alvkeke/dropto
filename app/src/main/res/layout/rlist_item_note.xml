<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/note_item_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/content_description_note_item_sender_avatar"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DropTo.Circle" />

    <LinearLayout
        android:id="@+id/note_item_content"
        app:layout_constraintStart_toEndOf="@id/note_item_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/note_item_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/note_item_sender_name"
                android:textColor="@color/color_text_main"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="DropTo" />

            <TextView
                android:id="@+id/note_item_create_time"
                android:layout_marginStart="6dp"
                android:textColor="@color/color_text_sub"
                android:textSize="11sp"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="12:30" />

            <LinearLayout
                android:id="@+id/note_item_status_container"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/note_item_status_edited"
                    android:src="@drawable/img_note_item_edited"
                    app:tint="@color/color_text_sub"
                    android:contentDescription="@string/description_note_item_modify_icon"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp" />

                <ImageView
                    android:id="@+id/note_item_status_deleted"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/icon_common_remove"
                    app:tint="@color/color_text_sub"
                    android:contentDescription="@string/description_note_item_deleted_icon"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp" />

                <ImageView
                    android:id="@+id/note_item_status_unsynced"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/icon_common_not_sync"
                    app:tint="@color/color_text_sub"
                    android:contentDescription="@string/description_note_item_not_synced_icon"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/note_item_text"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_text_main"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="content of the note"
            tools:visibility="visible" />

        <HorizontalScrollView
            android:id="@+id/note_item_media_scroll"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/note_item_media_container"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/note_item_file_container"
            android:orientation="vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/note_item_reaction_container"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</merge>
